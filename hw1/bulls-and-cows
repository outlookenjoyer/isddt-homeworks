#!/bin/bash

trap 'echo ""; echo "Чтобы выйти из игры, введите q или Q"' SIGINT

check_unique() {
    num=$1
    for ((i = 0; i < 4; i++))
    do
        for ((j = i + 1; j < 4; j++))
        do
            if [[ "${num:i:1}" == "${num:j:1}" ]]
            then
                return 1
            fi
        done
    done
    return 0
}

secret=""
while true
do
    first=$((RANDOM % 9 + 1))
    secret="$first"
    for ((k = 0; k < 3; k++))
    do
        secret="${secret}$((RANDOM % 10))"
    done
    if check_unique "$secret"
    then
        break
    fi
done

echo "********************************************************************************"
echo "* Я загадал 4-значное число с неповторяющимися цифрами. На каждом ходу делайте *"
echo "* попытку отгадать загаданное число. Попытка - это 4-значное число с           *"
echo "* неповторяющимися цифрами.                                                    *"
echo "********************************************************************************"
echo ""

step=1
history=()

while true
do
    read -p "Попытка $step: " guess

    if [[ -z "$guess" ]]
    then
        continue
    fi

    if [[ "$guess" == "q" || "$guess" == "Q" ]]
    then
        echo "Выход из игры. Загаданное число было: $secret"
        exit 1
    fi

    if [[ ! "$guess" =~ ^[1-9][0-9][0-9][0-9]$ ]]
    then
        echo "Ошибка! Нужно ввести 4-значное число (или q для выхода)"
        continue
    fi

    if ! check_unique "$guess"
    then
        echo "Ошибка! Цифры в числе не должны повторяться"
        continue
    fi

    bulls=0
    cows=0
    for ((i = 0; i < 4; i++))
    do
        for ((j = 0; j < 4; j++))
        do
            if [[ "${guess:i:1}" == "${secret:j:1}" ]]
            then
                if [[ $i -eq $j ]]
                then
                    bulls=$((bulls + 1))
                else
                    cows=$((cows + 1))
                fi
            fi
        done
    done

    echo "Коров - $cows Быков - $bulls"

    history+=("$step. $guess (Коров - $cows Быков - $bulls)")

    echo ""
    echo "История ходов:"
    for line in "${history[@]}"
    do
        echo "$line"
    done
    echo ""

    if [[ $bulls -eq 4 ]]
    then
        echo "Поздравляю! Вы угадали число $secret за $step ходов!"
        exit 0
    fi

    step=$((step + 1))
done
